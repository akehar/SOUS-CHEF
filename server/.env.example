# --- Claude (chat, recipe generation, default vision) ---
# Get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Gemini (optional alternative vision provider) ---
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

# --- Optional overrides ---
PORT=8787
# Conversational chef + recipe generation (highest quality)
SOUS_CHAT_MODEL=claude-opus-4-8
# Live vision checks — Haiku keeps the loop fast and ~$0.002/frame.
# Set to claude-opus-4-8 for maximum visual acuity if cost is no concern.
SOUS_VISION_MODEL=claude-haiku-4-5

# Vision provider: "anthropic" (default) or "gemini".
# If unset, picks automatically based on which API key is present.
# VISION_PROVIDER=gemini
# GEMINI_VISION_MODEL=gemini-2.5-flash

# Natural voice for the sous-chef (Gemini TTS, ~$0.005 per spoken step).
# Requires GEMINI_API_KEY. Without it the app falls back to system speech.
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore   # try: Kore, Puck, Charon, Aoede, Leda
